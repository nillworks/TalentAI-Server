{
  "name": "hiremind-backend",
  "version": "1.0.0",
  "description": "HireMind Backend Server",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "server": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "build:bundle": "esbuild api/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:mongodb --external:stripe --external:jose --external:@google/generative-ai --external:mammoth --external:pdf2json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "openai": "^6.48.0",
    "pdf2json": "^4.0.3",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
